# HosPrime local developer configuration
# Copy this file to .env and replace every CHANGE_ME value before starting.
# Never commit .env or real credentials.

ENVIRONMENT=development

# M0 is a loopback-only local preview. Remote exposure requires a separately
# reviewed deployment profile with firewall, TLS, identity and access controls.
HOSPRIME_BIND_ADDRESS=127.0.0.1

POSTGRES_DB=hosprime
POSTGRES_USER=hosprime
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hosprime:CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/hosprime
POSTGRES_URL=postgresql://hosprime:CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/hosprime

REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_NEO4J_PASSWORD
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Optional for the local M0 developer preview. Leave blank to run without an
# external AI provider. Provider-backed generation remains unavailable until a
# newly issued key is supplied through this untracked runtime file.
GEMINI_API_KEY=

# Generate at least 32 random bytes. Example command:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Initial local administrator. The password is used only when the account does
# not exist; container restarts never overwrite an existing password.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_ADMIN_PASSWORD

# Demo institutional agents/documents are never seeded by the deploy bootstrap.
SEED_DEMO_DATA=false

# Must contain both loopback browser origins for FRONTEND_PORT. Port 80 uses no
# explicit suffix; for FRONTEND_PORT=18080 use localhost:18080 and 127.0.0.1:18080.
CORS_ORIGINS=["http://localhost","http://127.0.0.1"]

BACKEND_PORT=8000
FRONTEND_PORT=80
