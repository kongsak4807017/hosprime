# Configuration variables for HosPrime Knowledge Oracle MVP
# Copy this file to .env and set actual API keys

# Google Gemini API Key (Required for actual LLM generation)
# Leave blank or use 'disabled' to operate in offline mock mode
GEMINI_API_KEY=

# Database Connection URL (SQLite fallback is used automatically if Postgres is empty)
DATABASE_URL=sqlite:///./hosprime.db
POSTGRES_URL=
# Example Postgres: postgresql://username:password@localhost:5432/hosprime

# Storage & Directory Settings
STORAGE_DIR=../storage
DOCUMENT_DIR=../storage/documents
INDEX_DIR=../storage/indexes

# Port and Host Configuration
PORT=8000
HOST=0.0.0.0

# Optional services configurations
REDIS_URL=
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
JWT_SECRET=dev-secret-key
