# HosPrime backend environment template
# Copy this file to backend/.env and provide newly issued credentials.

# Runtime
ENVIRONMENT=development
APP_NAME=HosPrime
APP_VERSION=1.1.0

# Authentication
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI provider
GEMINI_API_KEY=replace-with-a-new-provider-key
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Safe defaults: never enable these in production
ALLOW_DEMO_FALLBACKS=false
ALLOW_PSEUDO_EMBEDDINGS=false

# Database
DATABASE_URL=sqlite:///./hosprime.db
POSTGRES_URL=
REDIS_URL=

# Graph
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Storage
STORAGE_DIR=../storage
DOCUMENT_DIR=../storage/documents
INDEX_DIR=../storage/indexes
MAX_UPLOAD_BYTES=26214400

# Network
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173"]
